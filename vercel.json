{
  "version": 2,
  "name": "business-center-system",
  "builds": {
    "src": "package.json",
    "use": "@vercel/next"
  },
  "functions": {
    "app/api/users/route.ts": {
      "maxDuration": 30,
      "runtime": "nodejs18.x",
      "memory": 512,
      "runtime": "nodejs18.x"
    },
    "app/api/companies/route.ts": {
      "maxDuration": 30,
      "runtime": "nodejs18.x",
      "memory": 512
    },
    "app/api/employees/route.ts": {
      "maxDuration": 30,
      "runtime": "nodejs18.x",
      "memory": 512
    },
    "app/api/expiry/route.ts": {
      "maxDuration": 30,
      "runtime": "nodejs18.x",
      "memory": 512
    },
    "app/api/bootstrap/*/route.ts": {
      "maxDuration": 30,
      "runtime": "nodejs18.x",
      "memory": 512
    }
  },
  "routes": [
    {
      "src": "app/api/users/route.ts",
      "dest": "/api/users"
    },
    {
      "src": "app/api/companies/route.ts", 
      "dest": "/api/companies"
    },
    {
      "src": "app/api/employees/route.ts",
      "dest": "/api/employees"
    },
    {
      "src": "app/api/expiry/route.ts",
      "dest": "/api/expiry"
    },
    {
      "src": "app/api/bootstrap/creator/route.ts",
      "dest": "/api/bootstrap/creator"
    },
    {
      "src": "app/api/bootstrap/migrate/route.ts",
      "dest": "/api/bootstrap/migrate"
    },
    {
      "src": "app/api/bootstrap/reset-password/route.ts",
      "dest": "/api/bootstrap/reset-password"
    },
    {
      "src": "app/api/setup-complete/route.ts",
      "dest": "/api/setup-complete"
    },
    {
      "src": "app/api/setup-database/route.ts",
      "dest": "/api/setup-database"
    },
    {
      "src": "app/api/admin-setup/route.ts",
      "dest": "/api/admin-setup"
    },
    {
      "src": "app/api/bootstrap/check-tables/route.ts",
      "dest": "/api/bootstrap/check-tables"
    }
  ],
  "env": {
    "NEXT_PUBLIC_SUPABASE_URL": "@supabase_url",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "@supabase_anon_key",
    "SUPABASE_SERVICE_ROLE_KEY": "@supabase_service_role_key",
    "BOOTSTRAP_SECRET": "@bootstrap_secret",
    "CREATOR_EMAIL": "@creator_email",
    "CREATOR_PASSWORD": "@creator_password",
    "CREATOR_NAME": "@creator_name",
    "CREATOR_ROLE": "@creator_role",
    "NEXT_PUBLIC_APP_URL": "@app_url",
    "NODE_ENV": "@node_env",
    "JWT_SECRET": "@jwt_secret",
    "SESSION_SECRET": "@session_secret",
    "SENDGRID_API_KEY": "@sendgrid_api_key",
    "SMTP_HOST": "@smtp_host",
    "SMTP_USER": "@smtp_user",
    "SMTP_PASS": "@smtp_pass"
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_SUPABASE_URL": "https://your-project.supabase.co",
      "NEXT_PUBLIC_SUPABASE_ANON_KEY": "your-anon-key",
      "SUPABASE_SERVICE_ROLE_KEY": "your-service-role-key",
      "BOOTSTRAP_SECRET": "your-secure-bootstrap-secret",
      "CREATOR_EMAIL": "sirajkn.work@gmail.com",
      "CREATOR_PASSWORD": "SirajZaira@126",
      "CREATOR_NAME": "System Creator",
      "CREATOR_ROLE": "creator",
      "NEXT_PUBLIC_APP_URL": "https://yourdomain.com",
      "NODE_ENV": "production",
      "JWT_SECRET": "your-jwt-secret-key-here",
      "SESSION_SECRET": "your-session-secret-key-here",
      "SENDGRID_API_KEY": "your-sendgrid-api-key",
      "SMTP_HOST": "smtp.gmail.com",
      "SMTP_USER": "your-smtp-username",
      "SMTP_PASS": "your-smtp-password"
    }
  },
  "regions": ["sin1"],
  "framework": "nextjs",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "buildCommand": "npm run build",
  "git": {
    "preinstall": "npx only-allow npm"
  }
}
